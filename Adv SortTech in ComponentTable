</head>
<body>
    <div id="root"></div>
    <script type="text/babel">

       function StudentsTable() {
          //state
        var [students,studentsfun]=React.useState([
            {
                "firstname":"UmaSri",
                "lastname":"Gubbala",
                "gender":"Female"
            },
            
            {
                "firstname":"Nikhil",
                "lastname":"Kadali",
                "gender":"Male"
            },
            {
                "firstname":"SriDurga",
                "lastname":"Mamidisetti",
                "gender":"Female"
            },
            {
                "firstname":"Charan",
                "lastname":"Chellingi",
                "gender":"Male"
            },
            {
                "firstname":"Karthika",
                "lastname":"Katta",
                "gender":"Female"
            },
        ])
             //action
              function SortByKey(k){
                var temp=[...students];
                temp.sort((a,b)=>{
                    if(a[k]>b[k]){
                        return 1
                    }
                    else{
                        return -1
                    }
                })
                studentsfun([...temp])
              }
            //ui
         return (
           <div>
             <h1>Students Table Here:</h1>
             <table border="2">
                <thead>
                    <tr>
                        <th onClick={()=>{sortByFirstName()}}>Firstname</th>
                        <th onClick={()=>{sortByLastName()}}>Lastname</th>
                        <th onClick={()=>{sortByGender()}}>Gender</th>
                    </tr>
                </thead>
                <tbody>
                  {
                      students.map((stud)=>{
                         return (
                            <tr>
                                <td>{stud.firstname}</td>
                                <td>{stud.lastname}</td>
                                <td>{stud.gender}</td>
                            </tr>
                            )
                       })
                    }
                </tbody>    
             </table>
           </div>
         )
       }
    ReactDOM.render(<StudentsTable></StudentsTable>,document.getElementById("root"))       
    </script>
</body>
</html>